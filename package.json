{
  "name": "@consilioweb/payload-seo-analyzer",
  "version": "4.0.0",
  "description": "Payload CMS SEO plugin — 50+ checks, dashboard, Lexical JSON support, Flesch FR/EN readability, i18n",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./views": {
      "import": {
        "types": "./dist/views.d.ts",
        "default": "./dist/views.js"
      },
      "require": {
        "types": "./dist/views.d.cts",
        "default": "./dist/views.cjs"
      }
    }
  },
  "bin": {
    "seo-analyzer-uninstall": "./scripts/uninstall.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "!scripts/__tests__",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/client.js",
    "./dist/client.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:ui:setup": "cd e2e/ui && npm install && npx playwright install chromium",
    "test:e2e:ui": "cd e2e/ui && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "seo",
    "seo-analyzer",
    "seo-plugin",
    "seo-audit",
    "on-page-seo",
    "payload",
    "payload-cms",
    "payload-cms-plugin",
    "payload-plugin",
    "cms-seo",
    "meta-tags",
    "content-analysis",
    "readability",
    "readability-score",
    "flesch",
    "lexical",
    "next.js",
    "nextjs",
    "i18n",
    "french",
    "english",
    "structured-data",
    "json-ld",
    "sitemap",
    "seo-dashboard",
    "redirects",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pOwn3d/payload-seo-analyzer.git"
  },
  "homepage": "https://github.com/pOwn3d/payload-seo-analyzer#readme",
  "bugs": {
    "url": "https://github.com/pOwn3d/payload-seo-analyzer/issues"
  },
  "author": "ConsilioWEB <contact@consilioweb.fr> (https://consilioweb.fr)",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "peerDependencies": {
    "@payloadcms/next": ">=3.79.1 <4.0.0",
    "@payloadcms/ui": ">=3.79.1 <4.0.0",
    "next": "^15.2.0 || ^16.0.0",
    "payload": ">=3.79.1 <4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/ui": {
      "optional": true
    },
    "@payloadcms/next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "jsdom": "^29.1.1",
    "next": "^16.3.4",
    "payload": "^3.88.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
